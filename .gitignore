######################
.DS_Store
.DS_Store?

# backup files #
################
*.bak
*.zip
*.removed

# Extracted V2.9.1 content (intermediate data) #
#################################################
/v291-extracted/*
# But track the comparison reports (final output)
!/v291-extracted/vocabulary-comparison-report.html
!/v291-extracted/vocabulary-comparison-report.json
!/v291-extracted/vocabulary-comparison-report.md
!/v291-extracted/message-structures-decision-report.html
# CH02C fidelity ledger: every divergence from the published text (reviewable)
!/v291-extracted/vocabulary-deviations.json
!/v291-extracted/vocabulary-review-report.html
# Authored record of every change made to the published text -- not regenerable
!/v291-extracted/vocabulary-changelog.md
# Authored backlog for the pass after the fidelity load -- not regenerable
!/v291-extracted/vocabulary-future-corrections.md
# Findings for the V2 Management Group and TSMG. Generated from
# tooling/scripts/vocabulary_escalations.py, but tracked so the register is
# readable and diffable without running anything.
!/v291-extracted/vocabulary-v2mgmt-items.md
!/v291-extracted/utg-briefing.html
!/v291-extracted/v2mgmt-briefing.html
!/v291-extracted/v2mgmt-briefing.md
!/v291-extracted/utg-briefing.md
# What each Chapter 2C field maps to in the generated resources, and what is
# dropped. Generated from tooling/scripts/render_field_mapping.py, tracked so
# the loss list is readable and diffable without running anything.
!/v291-extracted/vocabulary-field-mapping.html
!/v291-extracted/vocabulary-field-mapping.md
/v291-canonical/message-structures/
/v291-canonical/fixes-report.html
/v2plus_docx/

# LLM-extracted V2.9.1 corpus (ADR-0006 Phase 1) — generated, large #
######################################################################
/v291-llm/*
# But track the cross-corpus comparison reports
!/v291-llm/comparison-report.md
!/v291-llm/three-way-comparison-report.md
!/v291-llm/vocabulary-comparison-report.md
!/v291-llm/vocabulary-comparison-report.json

# FHIR-vs-docx review registry (ADR-0006) #
###########################################
# registry.json is AUTHORED (holds review decisions + rationale) — track it.
# The change ledger is the durable output — track it.
# The worklist, apply-report, and escalations export are regenerable views.
/v291-review/review-worklist.md
/v291-review/apply-report.md
/v291-review/v2mgmt-escalations.md

# Generated FHIR resources for the V2.9.1 vocabulary IG #
##########################################################
/v291-fhir/*
# But track the divergence log (authored review content) and the resource itself
!/v291-fhir/conceptdomains-divergences.json
!/v291-fhir/CodeSystem-conceptdomains.json
# The UTG-shaped XML is the deliverable this workstream exists to produce, and
# it cannot be regenerated from the repository alone -- the corpus it is built
# from, /v291-extracted/vocabulary/, is itself ignored.
!/v291-fhir/utg/
!/v291-fhir/utg/**
!/v291-fhir/utg-write-report.json

# Canonical-collision smoke test #
##################################
# The harness is tracked; its build products are not.
/smoke-test/output/
/smoke-test/temp/
/smoke-test/template/
/smoke-test/input-cache/
/smoke-test/*.log
/smoke-test/input/resources/

# Vocabulary IG build artifacts
# - input/resources/ is staged by tooling/scripts/stage_vocab_ig.py
# - input-cache/ is the publisher's own package and terminology cache,
#   ignored for the same reason /input-cache is. rsync still carries it to
#   postproc-g, which is what the offline-terminology fallback relies on.
vocab-ig/input/resources/
vocab-ig/input-cache/
output-vocab
