##########################
*.png
# But keep images in these tracked directories
!local-template/content/assets/ico/*.png
!input/images/*.png
!input/images/*.jpg
!input/images/*.jpeg

# External repos (cloned, not submodules) #
############################################
/hl7.v2.terminology.v291/
/utg
# Both spellings: the workspace is mounted from a case-insensitive filesystem,
# so /utg and /UTG are one directory here but would be two on Linux.
/UTG
# THO published package (hl7.terminology.r5 v7.3.0), downloaded reference copy
/tho-r5/

# Template package staged for extraction to its own HL7/ig-template-v2plus repo #
##################################################################################
/ig-template-v2plus/

# Scratch / working files #
############################
/scratch/
/compare_message_structures.py
# Archive of files removed from the active tree but kept on disk for
# reference. Never propagated to main / build / IG Publisher.
/_archive/

# IDE / tool state #
#####################
.playwright-mcp/
.index.db
.index.json

# HTML generated from AsciiDoc
##############################
/website/**/*.html

# Don't commit this because it's so large #
###########################################
/input-cache
/input-cache/org.hl7.fhir.publisher.jar
/input-cache/publisher.jar

